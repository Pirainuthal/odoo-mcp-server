# Copy to .env (git-ignored) or set these in your MCP client config.
ODOO_URL=https://mycompany.odoo.com
ODOO_DB=mycompany
ODOO_USERNAME=bot@mycompany.com
ODOO_API_KEY=replace-with-an-api-key

# Safety (all optional)
ODOO_MCP_ALLOW_WRITE=0
ODOO_MCP_ALLOW_DELETE=0
# ODOO_MCP_MODELS=res.partner,sale.*,product.*
# ODOO_MCP_DENY_MODELS=hr.*
# ODOO_MCP_DEFAULT_LIMIT=50
# ODOO_MCP_MAX_LIMIT=200
# ODOO_TIMEOUT=30
